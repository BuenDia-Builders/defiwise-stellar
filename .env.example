NODE_ENV=development

# Stellar Admin Configuration (KEEP SECRET - NEVER COMMIT THE ACTUAL .env FILE)
# The admin secret key is used by backend API routes to sign transactions
# Get this from your admin Stellar wallet
ADMIN_SECRET_KEY=S...YOUR_SECRET_KEY_HERE...

# Optional: Rate limiting configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10
